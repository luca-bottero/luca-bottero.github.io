---
import Base from '../layouts/Base.astro';
import { langPrefix, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = langPrefix(lang);

const t = lang === 'it' ? {
  title: 'Scienza — Luca Bottero',
  desc: 'Fisico teorico: pubblicazioni peer-reviewed, tesi su dati ALICE/CERN e sul Geometric Deep Learning per la fisica su reticolo, fisica computazionale open source.',
  eyebrow: 'SCI//INDEX',
  h1: 'Scienza',
  sub: 'Fisico teorico di formazione, scienziato indipendente per scelta. Qui la parte verificabile: pubblicazioni peer-reviewed, ricerca di tesi, fisica computazionale pubblicata in open source.',
  pubsH: 'Pubblicazioni',
  pubsSub: 'Due paper a revisione dei pari — a NeurIPS e ad AAAI — e un preprint arXiv nato da una grande collaborazione. Su ciascuno dichiaro il mio ruolo, senza ambiguità.',
  pubs: [
    { yr: '2022', title: 'Unsupervised learning of geometrical features from images by explicit group actions enforcement', venue: 'NeurIPS 2022 — Workshop NeurReps (OpenReview)', tag: 'PEER-REVIEWED', href: 'https://openreview.net/forum?id=sEn61s0M1hy' },
    { yr: '2021', title: 'Physics-Informed Machine Learning Simulator for Wildfire Propagation', venue: 'AAAI-MLPS 2021 Spring Symposium · CEUR-WS Vol-2964 · primo autore · anche a JuliaCon 2021', tag: 'PEER-REVIEWED', href: 'https://ceur-ws.org/Vol-2964/article_171.pdf' },
    { yr: '2021', title: 'NeuralPDE: Automating Physics-Informed Neural Networks (PINNs) with Error Approximations', venue: 'arXiv:2107.09443 — preprint · collaborazione SciML (MIT JuliaLab), 14 autori', tag: 'PREPRINT', href: 'https://arxiv.org/abs/2107.09443' },
  ],
  bookH: 'Capitolo di libro',
  book: '"AI: Prometeo oppure Pandora del XXI secolo?" — in Il modello Partecipativo nella moda (a cura di F. Aimi, Franco Angeli, 2025).',
  thesesH: 'Le due tesi',
  theses: [
    { k: 'TESI MAGISTRALE — FISICA TEORICA, UNITO 2025', h: 'Geometric Deep Learning per la fisica su reticolo', d: 'Un modello di diffusione su grafi condizionato dalla temperatura fisica genera configurazioni del modello di Ising lungo tutto il diagramma di fase — addestrato su reticoli 32², campiona a 64² grazie alla natura geometrica dell\'architettura, validato contro Monte Carlo su magnetizzazione, calore specifico e funzioni di correlazione. In parallelo: un campionatore Monte Carlo per teorie di gauge SU(3) su GPU (heatbath di Kennedy–Pendleton, over-relaxation, tensione di stringa dai rapporti di Creutz).' },
    { k: 'TESI TRIENNALE — FISICA, UNITO 2022', h: 'L\'ipertrizio in ALICE al CERN, con il machine learning', d: 'Pipeline professionale di estrazione del segnale per il decadimento a tre corpi dell\'(anti-)ipertrizio in collisioni pp a √s = 13 TeV: classificatore BDT su 15 variabili cinematiche e di identificazione, ottimizzazione degli iperparametri, fit di massa invariante, plot di Dalitz e sistematiche — su dataset fino a ~8×10⁹ eventi.' },
  ],
  thesisFig: { src: '/assets/img/gdl_validation.png', cap: 'Dalla tesi magistrale: modello di diffusione vs Monte Carlo — magnetizzazione, calore specifico ed energia interna attraverso la transizione di fase di Ising' },
  galleryH: 'La scienza, da guardare',
  gallerySub: 'Fisica computazionale pubblicata in open source sul mio GitHub — simulazioni che puoi eseguire, non solo guardare.',
  figs: [
    { src: '/assets/video/peregrine_soliton.mp4', cap: 'Solitone di Peregrine — equazione di Schrödinger non lineare' },
    { src: '/assets/video/akhmediev_breather.mp4', cap: 'Breather di Akhmediev — instabilità modulazionale' },
    { src: '/assets/video/xpoint_animation.mp4', cap: 'Riconnessione a punto X — algoritmo di Boris relativistico, C++' },
    { src: '/assets/video/dipole_animation.mp4', cap: 'Intrappolamento in dipolo magnetico — fasce di radiazione in miniatura' },
  ],
  reposNote: 'Codice sorgente:',
  papersCta: 'Paper indipendenti ▸',
  leonardoH: 'Primo premio — hackathon Leonardo "Space Edition", 2026',
  leonardo: 'Vincitori assoluti. Il main track era un concept per una costellazione satellitare di Quantum Key Distribution a copertura globale; nelle side challenge code-centric il team ha realizzato la predizione di guasti alle antenne di terra da 3,8 milioni di righe di telemetria (ROC-AUC 0.968, 44 guasti su 44 anticipati con ~21 ore di preavviso) e ha reimplementato la propagazione orbitale SGP4 di oltre 100 satelliti come kernel CUDA custom.',
} : {
  title: 'Science — Luca Bottero',
  desc: 'Theoretical physicist: peer-reviewed publications, theses on ALICE/CERN data and Geometric Deep Learning for lattice physics, open-source computational physics.',
  eyebrow: 'SCI//INDEX',
  h1: 'Science',
  sub: 'Theoretical physicist by training, independent scientist by choice. Here is the verifiable part: peer-reviewed publications, thesis research, computational physics published open source.',
  pubsH: 'Publications',
  pubsSub: 'Two peer-reviewed venue papers — at NeurIPS and AAAI — and one arXiv preprint from a large collaboration. My role in each is stated plainly, no ambiguity.',
  pubs: [
    { yr: '2022', title: 'Unsupervised learning of geometrical features from images by explicit group actions enforcement', venue: 'NeurIPS 2022 — NeurReps Workshop (OpenReview)', tag: 'PEER-REVIEWED', href: 'https://openreview.net/forum?id=sEn61s0M1hy' },
    { yr: '2021', title: 'Physics-Informed Machine Learning Simulator for Wildfire Propagation', venue: 'AAAI-MLPS 2021 Spring Symposium · CEUR-WS Vol-2964 · first author · also at JuliaCon 2021', tag: 'PEER-REVIEWED', href: 'https://ceur-ws.org/Vol-2964/article_171.pdf' },
    { yr: '2021', title: 'NeuralPDE: Automating Physics-Informed Neural Networks (PINNs) with Error Approximations', venue: 'arXiv:2107.09443 — preprint · SciML collaboration (MIT JuliaLab), 14 authors', tag: 'PREPRINT', href: 'https://arxiv.org/abs/2107.09443' },
  ],
  bookH: 'Book chapter',
  book: '"AI: Prometheus or Pandora of the 21st century?" — in Il modello Partecipativo nella moda (ed. F. Aimi, Franco Angeli, 2025).',
  thesesH: 'The two theses',
  theses: [
    { k: 'MSc THESIS — THEORETICAL PHYSICS, UNITO 2025', h: 'Geometric Deep Learning for lattice physics', d: 'A graph diffusion model conditioned on physical temperature generates Ising configurations across the whole phase diagram — trained on 32² lattices, it samples at 64² thanks to the geometric nature of the architecture, validated against Monte Carlo on magnetization, specific heat and correlation functions. In parallel: a GPU Monte Carlo sampler for SU(3) gauge theories (Kennedy–Pendleton heatbath, over-relaxation, string tension from Creutz ratios).' },
    { k: 'BSc THESIS — PHYSICS, UNITO 2022', h: 'The hypertriton at ALICE/CERN, with machine learning', d: 'A professional signal-extraction pipeline for the 3-body decay of the (anti-)hypertriton in pp collisions at √s = 13 TeV: BDT classifier over 15 kinematic and particle-ID variables, hyperparameter optimization, invariant-mass fits, Dalitz plots and systematics — on datasets up to ~8×10⁹ events.' },
  ],
  thesisFig: { src: '/assets/img/gdl_validation.png', cap: 'From the MSc thesis: diffusion model vs Monte Carlo — magnetization, specific heat and internal energy across the Ising phase transition' },
  galleryH: 'Science you can watch',
  gallerySub: 'Computational physics published open source on my GitHub — simulations you can run, not just watch.',
  figs: [
    { src: '/assets/video/peregrine_soliton.mp4', cap: 'Peregrine soliton — nonlinear Schrödinger equation' },
    { src: '/assets/video/akhmediev_breather.mp4', cap: 'Akhmediev breather — modulational instability' },
    { src: '/assets/video/xpoint_animation.mp4', cap: 'X-point reconnection — relativistic Boris algorithm, C++' },
    { src: '/assets/video/dipole_animation.mp4', cap: 'Magnetic dipole trapping — miniature radiation belts' },
  ],
  reposNote: 'Source code:',
  papersCta: 'Independent papers ▸',
  leonardoH: 'First prize — Leonardo "Space Edition" hackathon, 2026',
  leonardo: 'Overall winners. The main track was a concept for a global-coverage Quantum Key Distribution satellite constellation; in the code-centric side challenges the team delivered ground-antenna fault prediction from 3.8M telemetry rows (ROC-AUC 0.968, 44/44 faults anticipated with ~21h warning) and reimplemented SGP4 orbital propagation of 100+ satellites as a custom CUDA kernel.',
};
---
<Base lang={lang} title={t.title} description={t.desc} path={`${p}/science/`}>
  <section class="section wrap" style="margin-top:70px;">
    <span class="eyebrow">{t.eyebrow}</span>
    <h1 class="display" style="font-size:clamp(36px,6vw,64px); margin-top:14px;">{t.h1}</h1>
    <p class="muted" style="max-width:64ch; font-size:16.5px; margin-top:16px;">{t.sub}</p>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <span class="eyebrow">SCI//PUBLISHED</span>
      <h2>{t.pubsH}</h2>
      <p class="sub">{t.pubsSub}</p>
    </div>
    <div class="timeline reveal">
      {t.pubs.map((pub: any) => (
        <div class="trow">
          <span class="yr">{pub.yr}</span>
          <span class="what">
            <b><a href={pub.href} rel="noopener" style="color:var(--ink)">{pub.title}</a></b>
            {pub.tag && <span class={`tag ${pub.tag === 'PEER-REVIEWED' ? 'ok' : ''}`} style="margin-left:8px; vertical-align:middle;">{pub.tag}</span>}
            <span> — {pub.venue}</span>
          </span>
        </div>
      ))}
      <div class="trow">
        <span class="yr">2025</span>
        <span class="what"><b>{t.bookH}</b><span> — {t.book}</span></span>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <span class="eyebrow">SCI//THESES</span>
      <h2>{t.thesesH}</h2>
    </div>
    <div class="grid-2">
      {t.theses.map((th: any) => (
        <div class="card flag reveal">
          <span class="k">{th.k}</span>
          <h3 style="margin-top:10px">{th.h}</h3>
          <p>{th.d}</p>
        </div>
      ))}
    </div>
    <figure class="figure reveal" style="margin:26px 0 0">
      <img src={t.thesisFig.src} alt={t.thesisFig.cap} loading="lazy" />
      <figcaption>{t.thesisFig.cap}</figcaption>
    </figure>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <span class="eyebrow">SCI//GALLERY</span>
      <h2>{t.galleryH}</h2>
      <p class="sub">{t.gallerySub}</p>
    </div>
    <div class="grid-2">
      {t.figs.map((f: any) => (
        <figure class="figure reveal" style="margin:0">
          <video autoplay loop muted playsinline preload="metadata" aria-label={f.cap}>
            <source src={f.src} type="video/mp4" />
          </video>
          <figcaption>{f.cap}</figcaption>
        </figure>
      ))}
    </div>
    <p class="reveal" style="margin-top:18px; font-family:var(--font-mono); font-size:12px; color:var(--dim);">
      {t.reposNote}
      <a href="https://github.com/luca-bottero/ChargedParticleSimulator" rel="noopener">ChargedParticleSimulator</a> ·
      <a href="https://github.com/luca-bottero/Computational_QM" rel="noopener">Computational_QM</a>
    </p>
  </section>

  <div class="band">
    <div class="wrap reveal">
      <span class="eyebrow">SCI//SPACE</span>
      <h2 class="display" style="font-size:clamp(20px,2.8vw,28px); margin-top:10px;">{t.leonardoH}</h2>
      <p class="muted" style="max-width:70ch; margin-top:12px;">{t.leonardo}</p>
    </div>
  </div>
</Base>
