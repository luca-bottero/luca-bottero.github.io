---
import Base from '../layouts/Base.astro';
import { langPrefix, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = langPrefix(lang);

const t = lang === 'it' ? {
  title: 'Drone Swarm — Sciami che si auto-organizzano | NouSynth',
  desc: 'Uno sciame di droni marittimi controllato da intelligenze decentralizzate: nessun pianificatore centrale, coordinamento emergente, azioni sempre validate.',
  k: 'NOUSYNTH // SWARM — CASO DI STUDIO',
  h1: 'Sciami che si auto-organizzano',
  one: 'Uno sciame di assetti marittimi comandato in linguaggio naturale. Ogni drone ha il proprio cervello agentico; nessuno comanda gli altri. Il coordinamento — pattugliamento, investigazione, scorta — emerge dallo scambio di messaggi tra pari.',
  probH: 'Il problema',
  prob: 'Il controllo centralizzato di uno sciame è un singolo punto di guasto e un collo di bottiglia decisionale. Le alternative classiche — regole fisse, macchine a stati — collassano davanti a missioni espresse in linguaggio naturale e a scenari imprevisti. La domanda: può ogni assetto ragionare da solo e la coordinazione emergere dal basso, in modo sicuro?',
  archH: 'L\'architettura',
  archPoints: [
    ['Un cervello per assetto', 'Ogni drone riceve il testo della missione, i contatti rilevati dai sensori e i messaggi dei pari — e decide da solo. Nessun pianificatore centrale, nessuna regola a parole chiave.'],
    ['Sicurezza per costruzione', 'Ogni decisione supera una validazione rigorosa prima di diventare azione: lo sciame agisce solo entro un repertorio di manovre verificate (pattuglia, investiga, scorta, riferisci...).'],
    ['Coordinamento emergente', 'I droni si parlano. Dalla conversazione emergono divisione dei settori, staffette di investigazione, coperture reciproche — comportamenti mai programmati esplicitamente.'],
    ['Mondo simulato completo', 'Simulatore fisico con scenari realistici e una mappa tattica in tempo reale — overlay nautici, griglia militare, e i "pensieri" di ogni assetto visibili in diretta.'],
  ],
  resH: 'Perché conta',
  res: 'È una dimostrazione concreta di autonomia multi-agente sicura: intelligenze che agiscono in un mondo (simulato) solo attraverso azioni validate, con coordinamento decentralizzato osservabile in tempo reale. Lo stesso approccio si trasferisce a flotte logistiche, monitoraggio ambientale, robotica di sciame.',
  back: '◂ Tutti i sistemi',
} : {
  title: 'Drone Swarm — Self-organizing swarms | NouSynth',
  desc: 'A maritime drone swarm controlled by decentralized intelligences: no central planner, emergent coordination, always-validated actions.',
  k: 'NOUSYNTH // SWARM — CASE STUDY',
  h1: 'Swarms that self-organize',
  one: 'A swarm of maritime assets commanded in plain language. Every drone runs its own agentic brain; nobody commands the others. Coordination — patrol, investigation, escort — emerges from peer-to-peer message exchange.',
  probH: 'The problem',
  prob: 'Centralized swarm control is a single point of failure and a decision bottleneck. The classical alternatives — fixed rules, state machines — collapse in front of missions expressed in natural language and unforeseen scenarios. The question: can each asset reason on its own, with coordination emerging bottom-up, safely?',
  archH: 'The architecture',
  archPoints: [
    ['One brain per asset', 'Each drone receives the mission text, sensed contacts and peer messages — and decides alone. No central planner, no keyword rules.'],
    ['Safety by construction', 'Every decision passes strict validation before becoming an action: the swarm only acts within a repertoire of verified manoeuvres (patrol, investigate, escort, report...).'],
    ['Emergent coordination', 'The drones talk to each other. Out of the conversation emerge sector splitting, investigation relays, mutual coverage — behaviours never explicitly programmed.'],
    ['A full simulated world', 'A physics simulator with realistic scenarios and a real-time tactical map — nautical overlays, military grid, and each asset\'s "thoughts" visible live.'],
  ],
  resH: 'Why it matters',
  res: 'It is a concrete demonstration of safe multi-agent autonomy: intelligences acting in a (simulated) world only through validated actions, with decentralized coordination observable in real time. The same approach transfers to logistics fleets, environmental monitoring, swarm robotics.',
  back: '◂ All systems',
};
---
<Base lang={lang} title={t.title} description={t.desc} path={`${p}/systems/drone-swarm/`}>
  <article class="section wrap" style="margin-top:70px;">
    <a class="mono" style="font-size:11px; letter-spacing:0.14em; color:var(--dim);" href={`${p}/systems/`}>{t.back}</a>
    <p class="eyebrow" style="margin-top:26px;">{t.k}</p>
    <h1 class="display" style="font-size:clamp(32px,5.4vw,58px); margin-top:14px;">{t.h1}</h1>
    <p style="max-width:66ch; font-size:17.5px; color:#c7ccd4; margin-top:22px;">{t.one}</p>

    <div class="section reveal">
      <div class="card flag" style="max-width:820px;">
        <span class="k">SYS//PROBLEM</span>
        <h3 style="margin-top:10px">{t.probH}</h3>
        <p>{t.prob}</p>
      </div>
    </div>

    <div class="section">
      <div class="section-head reveal">
        <span class="eyebrow">SYS//ARCHITECTURE</span>
        <h2 style="font-size:24px;">{t.archH}</h2>
      </div>
      <div class="grid-2">
        {t.archPoints.map((a: any, i: number) => (
          <div class="card reveal">
            <span class="k">{`0${i + 1}`}</span>
            <h3 style="margin-top:10px">{a[0]}</h3>
            <p>{a[1]}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="section reveal">
      <div class="card" style="max-width:820px; border-left:3px solid var(--accent);">
        <span class="k">SYS//IMPACT</span>
        <h3 style="margin-top:10px">{t.resH}</h3>
        <p>{t.res}</p>
      </div>
    </div>
  </article>
</Base>
