---
import Base from '../layouts/Base.astro';
import { langPrefix, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = langPrefix(lang);

const t = lang === 'it' ? {
  title: 'Luca Bottero — Fisico teorico, fondatore di NouSynth',
  desc: 'Sistemi di AI autonoma costruiti dai principi primi: un ingegnere artificiale che progetta componenti meccanici, sciami di droni auto-organizzati, un laboratorio che conduce ricerca in autonomia.',
  kicker: 'FISICO TEORICO // FONDATORE, ',
  h1a: 'Macchine che progettano.',
  h1b: 'Sciami che si organizzano.',
  h1c: 'Scienza senza permesso.',
  sub: 'Costruisco sistemi di intelligenza artificiale autonoma partendo dai principi primi: un ingegnere artificiale che trasforma una frase in un progetto meccanico funzionante, sciami di droni senza comando centrale, un laboratorio che conduce la propria ricerca. La fisica è il mio modo di pensare; i sistemi consegnati sono la prova.',
  ctaSystems: 'I sistemi ▸',
  ctaRecord: 'Il percorso ▸',
  stats: [
    { v: '10', suffix: '+', l: 'Sistemi consegnati' },
    { v: '2', suffix: '', l: 'Paper peer-reviewed' },
    { v: '1º', l: 'Premio Leonardo 2026', literal: true },
    { v: '2018', l: 'ML dal', literal: true },
  ],
  flagshipsHead: 'Sistemi di punta',
  flagshipsSub: 'Tre sistemi autonomi, un unico framework proprietario sotto di essi. Ogni caso di studio: problema, architettura, risultato.',
  flagships: [
    { href: `${p}/systems/aida/`, k: 'NOUSYNTH // AIDA', h: 'Descrivilo. Parametrizzalo. Consegnalo.', d: 'La piattaforma AI-native per la progettazione meccanica: dall\'intento ingegneristico a modelli 3D completamente parametrici, in una conversazione. In produzione.' },
    { href: `${p}/systems/drone-swarm/`, k: 'NOUSYNTH // SWARM', h: 'Sciami che si auto-organizzano', d: 'Ogni drone ha un proprio cervello AI e decide da solo; il coordinamento emerge dalla comunicazione tra pari. Nessun pianificatore centrale.' },
    { href: `${p}/systems/eigenlab/`, k: 'NOUSYNTH // EIGENLAB', h: 'Un laboratorio autonomo', d: 'Gli assegni una domanda e un budget: pianifica, sperimenta, si auto-critica e sintetizza — osservabile in diretta, con limiti di spesa rigidi.' },
  ],
  nsHead: 'Il marchio NouSynth',
  nsSub: 'Nous (mente) + synthesis. Tecnologie di AI per un impatto concreto — un framework proprietario per agenti, un intero ecosistema di sistemi costruiti sopra, clienti reali in produzione.',
  nsCta: 'La dottrina ▸',
  sciHead: 'La scienza, da guardare',
  sciSub: 'Fisica computazionale pubblicata in open source: solitoni quantistici, particelle relativistiche in campi elettromagnetici, modelli generativi per la fisica su reticolo.',
  sciCta: 'La pagina scienza ▸',
  fig1: 'Solitone di Peregrine — evoluzione NLSE',
  fig2: 'Riconnessione a punto X — integratore di Boris, C++',
  recordHead: 'Il percorso, verificabile',
  recordSub: 'Ogni riga è controllabile. Nessun aggettivo, solo fatti.',
  recordRows: [
    { yr: '2018', b: 'Libreria C++ di reti neurali', s: ' scritta da zero per la tesi di maturità' },
    { yr: '2021', b: 'Paper AAAI-MLPS + talk a JuliaCon', s: ' — simulatore di incendi physics-informed, con il JuliaLab del MIT' },
    { yr: '2022', b: 'Paper al workshop NeurIPS (NeurReps)', s: ' · tesi su dati ALICE/CERN con ML' },
    { yr: '2025', b: 'Docente Sole 24 Ore Business School', s: ' — "Faculty d\'Eccellenza" · capitolo di libro pubblicato' },
    { yr: '2026', b: 'Primo premio, hackathon Leonardo "Space Edition"', s: ' · EigenLab, sciame di droni e ABACUS operativi' },
  ],
  recordCta: 'Percorso completo ▸',
  contactHead: 'Costruiamo qualcosa.',
  contactSub: 'Consulenza AI di livello di ricerca, sistemi su misura, formazione executive. O semplicemente una conversazione seria.',
  contactCta: 'Scrivimi',
} : {
  title: 'Luca Bottero — Theoretical physicist, founder of NouSynth',
  desc: 'Autonomous AI systems built from first principles: an AI engineer that designs mechanical parts, self-organizing drone swarms, a laboratory that runs its own research.',
  kicker: 'THEORETICAL PHYSICIST // FOUNDER, ',
  h1a: 'Machines that design.',
  h1b: 'Swarms that organize.',
  h1c: 'Science without permission.',
  sub: 'I build autonomous AI systems from first principles — an AI engineer that turns a sentence into a working mechanical design, drone swarms with no central commander, a laboratory that runs its own research. Physics is how I think; shipped systems are the proof.',
  ctaSystems: 'The systems ▸',
  ctaRecord: 'The record ▸',
  stats: [
    { v: '10', suffix: '+', l: 'Systems shipped' },
    { v: '2', suffix: '', l: 'Peer-reviewed papers' },
    { v: '1st', l: 'Leonardo prize 2026', literal: true },
    { v: '2018', l: 'ML since', literal: true },
  ],
  flagshipsHead: 'Flagship systems',
  flagshipsSub: 'Three autonomous systems, one proprietary framework underneath. Each case study: problem, architecture, outcome.',
  flagships: [
    { href: `${p}/systems/aida/`, k: 'NOUSYNTH // AIDA', h: 'Describe it. Parametrize it. Ship it.', d: 'The AI-native mechanical design platform: from engineering intent to fully parametric 3D models, in one conversation. In production.' },
    { href: `${p}/systems/drone-swarm/`, k: 'NOUSYNTH // SWARM', h: 'Swarms that self-organize', d: 'Every drone runs its own AI brain and decides alone; coordination emerges from peer communication. No central planner.' },
    { href: `${p}/systems/eigenlab/`, k: 'NOUSYNTH // EIGENLAB', h: 'An autonomous laboratory', d: 'Assign it a question and a budget: it plans, experiments, critiques itself and synthesizes — observable live, under hard spending limits.' },
  ],
  nsHead: 'The NouSynth mark',
  nsSub: 'Nous (mind) + synthesis. AI technologies for practical impact — one proprietary agent framework, a whole ecosystem of systems built on it, real clients in production.',
  nsCta: 'The doctrine ▸',
  sciHead: 'Science you can watch',
  sciSub: 'Computational physics published open source: quantum solitons, relativistic particles in electromagnetic fields, generative models for lattice physics.',
  sciCta: 'The science page ▸',
  fig1: 'Peregrine soliton — NLSE evolution',
  fig2: 'X-point reconnection — Boris integrator, C++',
  recordHead: 'The record, verifiable',
  recordSub: 'Every line is checkable. No adjectives, only facts.',
  recordRows: [
    { yr: '2018', b: 'C++ neural-network library', s: ' written from scratch for the high-school thesis' },
    { yr: '2021', b: 'AAAI-MLPS paper + JuliaCon talk', s: ' — physics-informed wildfire simulator, with MIT JuliaLab' },
    { yr: '2022', b: 'NeurIPS workshop paper (NeurReps)', s: ' · thesis on ALICE/CERN data with ML' },
    { yr: '2025', b: 'Lecturer, Sole 24 Ore Business School', s: ' — "Faculty d\'Eccellenza" · book chapter published' },
    { yr: '2026', b: 'First prize, Leonardo "Space Edition" hackathon', s: ' · EigenLab, drone swarm and ABACUS operational' },
  ],
  recordCta: 'Full record ▸',
  contactHead: "Let's build something.",
  contactSub: 'Research-grade AI consulting, custom systems, executive training. Or simply a serious conversation.',
  contactCta: 'Write to me',
};
---
<Base lang={lang} title={t.title} description={t.desc} path={`${p}/`}>
  <section class="hero">
    <canvas id="hero-canvas" aria-hidden="true"></canvas>
    <div class="wrap inner">
      <p class="kicker stage s1">{t.kicker}<b>NOUSYNTH</b></p>
      <h1>
        <span class="stage s2" style="display:block">{t.h1a}</span>
        <span class="stage s3" style="display:block">{t.h1b}</span>
        <span class="stage s4 acc" style="display:block">{t.h1c}</span>
      </h1>
      <p class="sub stage s5">{t.sub}</p>
      <div class="stage s5" style="display:flex; gap:12px; flex-wrap:wrap;">
        <a class="btn primary" href={`${p}/systems/`}>{t.ctaSystems}</a>
        <a class="btn" href={`${p}/record/`}>{t.ctaRecord}</a>
      </div>
      <div class="stats stage s5" style="margin-top:52px; max-width:720px;">
        {t.stats.map((s: any) => (
          <div class="stat">
            {s.literal
              ? <div class="v">{s.v}</div>
              : <div class="v"><span data-count={s.v} data-suffix={s.suffix}>{s.v}{s.suffix}</span></div>}
            <div class="l">{s.l}</div>
          </div>
        ))}
      </div>
      <div class="telemetry">
        <span>LUCA BOTTERO</span>
        <span class="tnum">{lang === 'it' ? '45.0703°N 7.6869°E — TORINO' : '45.0703°N 7.6869°E — TURIN'}</span>
        <span class="lit">{lang === 'it' ? 'STATO: IN COSTRUZIONE' : 'STATUS: BUILDING'}</span>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <span class="eyebrow">SYS/01</span>
      <h2>{t.flagshipsHead}</h2>
      <p class="sub">{t.flagshipsSub}</p>
    </div>
    <div class="grid-3">
      {t.flagships.map((f: any) => (
        <a class="card flag reveal" href={f.href}>
          <span class="k">{f.k}</span>
          <h3 style="margin-top:10px">{f.h}</h3>
          <p>{f.d}</p>
        </a>
      ))}
    </div>
  </section>

  <div class="band">
    <div class="wrap" style="display:flex; flex-wrap:wrap; gap:26px 60px; align-items:center; justify-content:space-between;">
      <div class="reveal" style="max-width:60ch;">
        <span class="eyebrow">NS//MARK</span>
        <h2 class="display" style="font-size:clamp(22px,3vw,30px); margin-top:10px;">{t.nsHead}</h2>
        <p class="muted" style="margin-top:12px; font-size:15.5px;">{t.nsSub}</p>
      </div>
      <a class="btn reveal" href={`${p}/nousynth/`}>{t.nsCta}</a>
    </div>
  </div>

  <section class="section wrap">
    <div class="section-head reveal">
      <span class="eyebrow">SCI/01</span>
      <h2>{t.sciHead}</h2>
      <p class="sub">{t.sciSub}</p>
    </div>
    <div class="grid-2">
      <figure class="figure reveal" style="margin:0">
        <video autoplay loop muted playsinline preload="metadata" aria-label={t.fig1}>
          <source src="/assets/video/peregrine_soliton.mp4" type="video/mp4" />
        </video>
        <figcaption>{t.fig1}</figcaption>
      </figure>
      <figure class="figure reveal" style="margin:0">
        <video autoplay loop muted playsinline preload="metadata" aria-label={t.fig2}>
          <source src="/assets/video/xpoint_animation.mp4" type="video/mp4" />
        </video>
        <figcaption>{t.fig2}</figcaption>
      </figure>
    </div>
    <div class="reveal" style="margin-top:22px;">
      <a class="btn" href={`${p}/science/`}>{t.sciCta}</a>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <span class="eyebrow">REC/01</span>
      <h2>{t.recordHead}</h2>
      <p class="sub">{t.recordSub}</p>
    </div>
    <div class="timeline reveal">
      {t.recordRows.map((r: any) => (
        <div class="trow">
          <span class="yr">{r.yr}</span>
          <span class="what"><b>{r.b}</b><span>{r.s}</span></span>
        </div>
      ))}
    </div>
    <div class="reveal" style="margin-top:22px;">
      <a class="btn" href={`${p}/record/`}>{t.recordCta}</a>
    </div>
  </section>

  <div class="band" style="text-align:center;">
    <div class="wrap reveal">
      <h2 class="display" style="font-size:clamp(26px,4vw,40px);">{t.contactHead}</h2>
      <p class="muted" style="max-width:56ch; margin:14px auto 30px;">{t.contactSub}</p>
      <a class="btn primary" href="mailto:lucabottero99@gmail.com">{t.contactCta}</a>
    </div>
  </div>

  <script is:inline>
    // Hero field: drifting particle lattice with constellation links,
    // mouse-reactive, with periodic radial energy bursts.
    (function () {
      var canvas = document.getElementById('hero-canvas');
      if (!canvas) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var ctx = canvas.getContext('2d');
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var W, H, parts = [], bursts = [];
      var mouse = { x: -9999, y: -9999 };
      var running = true;

      function resize() {
        var r = canvas.parentElement.getBoundingClientRect();
        W = r.width; H = r.height;
        canvas.width = W * dpr; canvas.height = H * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        var n = Math.min(110, Math.floor((W * H) / 16000));
        parts = [];
        for (var i = 0; i < n; i++) {
          parts.push({
            x: Math.random() * W, y: Math.random() * H,
            vx: (Math.random() - 0.5) * 0.35, vy: (Math.random() - 0.5) * 0.35,
            r: 0.8 + Math.random() * 1.6,
          });
        }
      }

      function spawnBurst() {
        if (parts.length === 0) return;
        var s = parts[Math.floor(Math.random() * parts.length)];
        bursts.push({ x: s.x, y: s.y, r: 0, max: 90 + Math.random() * 130, a: 0.5 });
      }

      var lastBurst = 0;
      function frame(now) {
        if (!running) return;
        ctx.clearRect(0, 0, W, H);

        if (now - lastBurst > 2600 + Math.random() * 1800) { spawnBurst(); lastBurst = now; }

        // links
        var linkDist = Math.min(150, W / 8);
        ctx.lineWidth = 1;
        for (var i = 0; i < parts.length; i++) {
          var a = parts[i];
          for (var j = i + 1; j < parts.length; j++) {
            var b = parts[j];
            var dx = a.x - b.x, dy = a.y - b.y;
            var d2 = dx * dx + dy * dy;
            if (d2 < linkDist * linkDist) {
              var alpha = (1 - Math.sqrt(d2) / linkDist) * 0.16;
              ctx.strokeStyle = 'rgba(77,141,246,' + alpha.toFixed(3) + ')';
              ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
            }
          }
        }

        // particles
        for (var k = 0; k < parts.length; k++) {
          var pt = parts[k];
          // gentle mouse repulsion
          var mdx = pt.x - mouse.x, mdy = pt.y - mouse.y;
          var md2 = mdx * mdx + mdy * mdy;
          if (md2 < 120 * 120 && md2 > 1) {
            var f = 14 / md2;
            pt.vx += mdx * f; pt.vy += mdy * f;
          }
          pt.vx *= 0.985; pt.vy *= 0.985;
          pt.vx += (Math.random() - 0.5) * 0.012;
          pt.vy += (Math.random() - 0.5) * 0.012;
          pt.x += pt.vx; pt.y += pt.vy;
          if (pt.x < -10) pt.x = W + 10; if (pt.x > W + 10) pt.x = -10;
          if (pt.y < -10) pt.y = H + 10; if (pt.y > H + 10) pt.y = -10;
          ctx.fillStyle = 'rgba(130,170,246,0.75)';
          ctx.beginPath(); ctx.arc(pt.x, pt.y, pt.r, 0, 6.2832); ctx.fill();
        }

        // energy bursts: expanding rings that briefly light nearby links
        for (var q = bursts.length - 1; q >= 0; q--) {
          var bu = bursts[q];
          bu.r += 2.2; bu.a *= 0.972;
          if (bu.r > bu.max || bu.a < 0.02) { bursts.splice(q, 1); continue; }
          ctx.strokeStyle = 'rgba(77,141,246,' + bu.a.toFixed(3) + ')';
          ctx.lineWidth = 1.4;
          ctx.beginPath(); ctx.arc(bu.x, bu.y, bu.r, 0, 6.2832); ctx.stroke();
          ctx.strokeStyle = 'rgba(160,200,255,' + (bu.a * 0.5).toFixed(3) + ')';
          ctx.beginPath(); ctx.arc(bu.x, bu.y, bu.r * 0.72, 0, 6.2832); ctx.stroke();
        }

        requestAnimationFrame(frame);
      }

      canvas.parentElement.addEventListener('pointermove', function (e) {
        var r = canvas.getBoundingClientRect();
        mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
      });
      canvas.parentElement.addEventListener('pointerleave', function () {
        mouse.x = -9999; mouse.y = -9999;
      });
      document.addEventListener('visibilitychange', function () {
        running = !document.hidden;
        if (running) requestAnimationFrame(frame);
      });
      window.addEventListener('resize', resize);
      resize();
      requestAnimationFrame(frame);
    })();
  </script>
</Base>
