---
import Base from '../layouts/Base.astro';
import { langPrefix, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = langPrefix(lang);

const t = lang === 'it' ? {
  title: 'NouSynth — Tecnologie di AI per un impatto concreto',
  desc: 'NouSynth è il marchio con cui Luca Bottero costruisce sistemi di AI autonoma: un framework proprietario per agenti e sette sistemi operativi costruiti sopra.',
  eyebrow: 'NS//DOTTRINA',
  h1: 'NouSynth',
  tagline: 'Nous — mente. Synthesis — costruzione. Tecnologie di AI per un impatto concreto nel business e nella vita reale.',
  doctrine: [
    { h: 'Dai principi primi', d: 'Nessun wrapper, nessuna dipendenza da framework di moda. Il cuore di ogni sistema NouSynth è nagentx, un framework proprietario per agenti costruito da zero. I suoi interni restano riservati: i suoi risultati sono i sistemi qui sotto.' },
    { h: 'Autonomia, non automazione', d: 'La differenza tra uno script e un sistema NouSynth: i sistemi decidono. Agiscono, si correggono, si coordinano tra loro — sotto vincoli e budget rigidi, con ogni azione tracciata.' },
    { h: 'In produzione, non in demo', d: 'Sistemi multi-tenant con autenticazione, monitoraggio dei costi e deploy in cloud. La ricerca diventa prodotto o non conta.' },
  ],
  ecosystemHead: 'Un framework, un ecosistema',
  ecosystemSub: 'Ogni sistema qui sotto condivide lo stesso nucleo proprietario. Questa è la prova architetturale: non esperimenti sparsi, ma un ecosistema coerente. Qui i più rappresentativi.',
  systems: [
    { href: `${p}/systems/aida/`, name: 'AIDA', d: 'Progettazione meccanica parametrica guidata dall\'AI: descrivilo, parametrizzalo, consegnalo.', tag: 'PUNTA' },
    { href: `${p}/systems/drone-swarm/`, name: 'Drone Swarm', d: 'Sciame marittimo auto-organizzato, comandato in linguaggio naturale.', tag: 'PUNTA' },
    { href: `${p}/systems/eigenlab/`, name: 'EigenLab', d: 'Un laboratorio di ricerca autonomo: osservabile in diretta, con limiti di spesa rigidi.', tag: 'PUNTA' },
    { href: `${p}/systems/`, name: 'ABACUS', d: 'Analista AI in streaming su un ERP in produzione.', tag: 'CLIENTE' },
    { href: `${p}/systems/`, name: 'TILT', d: 'RAG giuridico sul diritto doganale UE con ingestione automatica da EUR-Lex.', tag: 'CLIENTE' },
    { href: `${p}/systems/`, name: 'Guide Scheduler', d: 'Ottimizzazione combinatoria con simulated annealing per un tour operator reale.', tag: 'CLIENTE' },
    { href: `${p}/systems/`, name: 'second_brain', d: 'Assistente vocale in tempo reale, interamente locale su una GPU consumer.', tag: 'R&D' },
  ],
  clientsHead: 'In produzione per',
  clientsSub: 'Alcuni clienti sono citabili, altri restano riservati per accordo. Gli slot vuoti si riempiranno.',
  clients: ['Tertium', 'Fondazione DIG421', '— riservato —', '— riservato —'],
  domainNote: 'Le applicazioni NouSynth sono servite sotto',
  cta: 'Vuoi un sistema così? Scrivimi',
} : {
  title: 'NouSynth — AI technologies for practical impact',
  desc: 'NouSynth is the mark under which Luca Bottero builds autonomous AI systems: a proprietary agent framework and seven operational systems built on it.',
  eyebrow: 'NS//DOCTRINE',
  h1: 'NouSynth',
  tagline: 'Nous — mind. Synthesis — building. AI technologies for practical impact in business and daily life.',
  doctrine: [
    { h: 'From first principles', d: 'No wrappers, no dependence on fashionable frameworks. At the core of every NouSynth system is nagentx, a proprietary agent framework built from scratch. Its internals stay confidential: its results are the systems below.' },
    { h: 'Autonomy, not automation', d: 'The difference between a script and a NouSynth system: the systems decide. They act, correct themselves, and coordinate with each other — under hard constraints and budgets, with every action audited.' },
    { h: 'In production, not in demos', d: 'Multi-tenant systems with authentication, cost metering and cloud deployment. Research becomes product or it does not count.' },
  ],
  ecosystemHead: 'One framework, one ecosystem',
  ecosystemSub: 'Every system below shares the same proprietary core. That is the architectural proof: not scattered experiments — one coherent ecosystem. The most representative ones are shown here.',
  systems: [
    { href: `${p}/systems/aida/`, name: 'AIDA', d: 'AI-powered parametric mechanical design: describe it, parametrize it, ship it.', tag: 'FLAGSHIP' },
    { href: `${p}/systems/drone-swarm/`, name: 'Drone Swarm', d: 'Self-organizing maritime swarm, commanded in plain language.', tag: 'FLAGSHIP' },
    { href: `${p}/systems/eigenlab/`, name: 'EigenLab', d: 'An autonomous research laboratory: observable live, under hard spending limits.', tag: 'FLAGSHIP' },
    { href: `${p}/systems/`, name: 'ABACUS', d: 'Streaming AI analyst over a production ERP.', tag: 'CLIENT' },
    { href: `${p}/systems/`, name: 'TILT', d: 'Legal RAG over EU customs law with automated EUR-Lex ingestion.', tag: 'CLIENT' },
    { href: `${p}/systems/`, name: 'Guide Scheduler', d: 'Combinatorial optimization via simulated annealing for a real tour operator.', tag: 'CLIENT' },
    { href: `${p}/systems/`, name: 'second_brain', d: 'Real-time voice assistant, fully local on a consumer GPU.', tag: 'R&D' },
  ],
  clientsHead: 'In production for',
  clientsSub: 'Some clients can be named, others remain confidential by agreement. The empty slots will fill.',
  clients: ['Tertium', 'Fondazione DIG421', '— confidential —', '— confidential —'],
  domainNote: 'NouSynth applications are served under',
  cta: 'Want a system like these? Write to me',
};
---
<Base lang={lang} title={t.title} description={t.desc} path={`${p}/nousynth/`}>
  <section class="section wrap" style="margin-top:70px;">
    <span class="eyebrow">{t.eyebrow}</span>
    <h1 class="display" style="font-size:clamp(36px,6vw,64px); margin-top:14px;">
      {t.h1}<span style="color:var(--accent)">.</span>
    </h1>
    <p class="muted" style="max-width:60ch; font-size:17px; margin-top:18px;">{t.tagline}</p>
  </section>

  <section class="section wrap">
    <div class="grid-3">
      {t.doctrine.map((d: any, i: number) => (
        <div class="card reveal">
          <span class="k">{`NS/0${i + 1}`}</span>
          <h3 style="margin-top:10px">{d.h}</h3>
          <p>{d.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <span class="eyebrow">NS//ECOSYSTEM</span>
      <h2>{t.ecosystemHead}</h2>
      <p class="sub">{t.ecosystemSub}</p>
    </div>
    <div class="card reveal" style="text-align:center; padding:18px; margin-bottom:16px;">
      <span class="mono" style="font-size:13px; letter-spacing:0.2em; color:var(--accent); font-weight:700;">NAGENTX</span>
      <p style="font-family:var(--font-mono); font-size:10.5px; letter-spacing:0.12em; text-transform:uppercase; color:var(--dim); margin-top:6px;">
        {lang === 'it' ? 'Un framework proprietario · Un ecosistema di sistemi · Interni riservati' : 'One proprietary framework · An ecosystem of systems · Internals confidential'}
      </p>
    </div>
    <div class="grid-3">
      {t.systems.map((s: any) => (
        <a class="card reveal" href={s.href}>
          <div style="display:flex; justify-content:space-between; align-items:baseline; gap:10px;">
            <h3>{s.name}</h3>
            <span class={`tag ${s.tag === 'FLAGSHIP' || s.tag === 'PUNTA' ? 'blue' : ''}`}>{s.tag}</span>
          </div>
          <p>{s.d}</p>
        </a>
      ))}
    </div>
  </section>

  <div class="band">
    <div class="wrap">
      <div class="section-head reveal" style="margin-bottom:22px;">
        <span class="eyebrow">NS//FIELD</span>
        <h2 style="font-size:clamp(20px,2.6vw,26px);">{t.clientsHead}</h2>
        <p class="sub">{t.clientsSub}</p>
      </div>
      <div class="reveal" style="display:flex; flex-wrap:wrap; gap:12px;">
        {t.clients.map((c: string) => (
          <span class="tag" style="padding:12px 22px; font-size:12px;">{c}</span>
        ))}
      </div>
      <p class="reveal" style="margin-top:26px; font-family:var(--font-mono); font-size:12px; color:var(--dim);">
        {t.domainNote} <a href="https://nousynth.com" rel="noopener">*.nousynth.com</a>
      </p>
    </div>
  </div>

  <section class="section wrap" style="text-align:center;">
    <a class="btn primary reveal" href="mailto:lucabottero99@gmail.com">{t.cta}</a>
  </section>
</Base>
